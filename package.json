{
  "name": "landerpilot-trae-mcp",
  "version": "0.2.0",
  "description": "LanderPilot 建站与 PW 验证引导，兼容干活宝 AI pi 插件和 Trae MCP。",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "files": [
    ".claude-plugin/",
    ".trae/mcp.example.json",
    "blueprints/",
    "docs/",
    "generators/",
    "skills/",
    "scripts/",
    "ganhuo-plugin.json",
    "mcp.local.example.json",
    "mcp.remote.example.json",
    "cloud-proxy.mjs",
    "server.mjs",
    "README.md",
    "pi-extension.mjs"
  ],
  "bin": {
    "landerpilot-local-mcp": "./server.mjs",
    "landerpilot-cloud-mcp": "./cloud-proxy.mjs",
    "landerpilot-trae-setup": "./scripts/setup-trae.mjs",
    "landerpilot-trae-doctor": "./scripts/doctor-trae.mjs"
  },
  "scripts": {
    "test:promotion": "node --test generators/shared/partnerwhiz-verification.test.mjs skills/landerpilot/scripts/create-promotion-site.test.mjs pi-extension.test.mjs",
    "start": "node server.mjs",
    "start:cloud": "node cloud-proxy.mjs",
    "inspect": "node scripts/inspect-tools.mjs",
    "smoke": "node scripts/smoke-call.mjs",
    "pack:check": "npm pack --dry-run",
    "verify:distribution": "node scripts/verify-distribution.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "pi": {
    "extensions": [
      "./pi-extension.mjs"
    ]
  }
}
