---
interface Props {
  size?: "xs" | "sm" | "md" | "lg";
  variant?: "spinner" | "dots" | "bars";
  label?: string;
  class?: string;
}

const { size = "md", variant = "spinner", label = "Loading", class: extra = "" } = Astro.props;

const sizeClass = {
  xs: "h-3 w-3",
  sm: "h-4 w-4",
  md: "h-6 w-6",
  lg: "h-8 w-8",
}[size];
---

<span
  role="status"
  aria-label={label}
  class:list={["inline-flex items-center justify-center text-primary", extra]}
>
  {variant === "spinner" && (
    <span class:list={["lp-spinner block rounded-full border-2 border-current border-r-transparent", sizeClass]}></span>
  )}
  {variant === "dots" && (
    <span class:list={["inline-flex items-center gap-1", sizeClass]}>
      <span class="lp-dot block h-1.5 w-1.5 rounded-full bg-current" style="animation-delay: 0s"></span>
      <span class="lp-dot block h-1.5 w-1.5 rounded-full bg-current" style="animation-delay: .15s"></span>
      <span class="lp-dot block h-1.5 w-1.5 rounded-full bg-current" style="animation-delay: .3s"></span>
    </span>
  )}
  {variant === "bars" && (
    <span class:list={["inline-flex items-end gap-0.5", sizeClass]}>
      <span class="lp-bar block w-0.5 bg-current" style="animation-delay: 0s"></span>
      <span class="lp-bar block w-0.5 bg-current" style="animation-delay: .15s"></span>
      <span class="lp-bar block w-0.5 bg-current" style="animation-delay: .3s"></span>
      <span class="lp-bar block w-0.5 bg-current" style="animation-delay: .45s"></span>
    </span>
  )}
  <span class="sr-only">{label}</span>
</span>

<style>
  .lp-spinner { animation: lp-spin 0.9s linear infinite; }
  .lp-dot { animation: lp-pulse 1s ease-in-out infinite; }
  .lp-bar { height: 100%; animation: lp-bar-bounce 1s ease-in-out infinite; transform-origin: bottom; }
  @keyframes lp-spin { to { transform: rotate(360deg); } }
  @keyframes lp-pulse { 0%, 80%, 100% { opacity: 0.3; } 40% { opacity: 1; } }
  @keyframes lp-bar-bounce { 0%, 100% { transform: scaleY(0.4); } 50% { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) {
    .lp-spinner, .lp-dot, .lp-bar { animation: none; }
  }
</style>
