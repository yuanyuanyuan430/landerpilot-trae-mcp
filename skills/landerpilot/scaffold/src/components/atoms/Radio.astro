---
interface Props {
  name: string;
  id?: string;
  value: string;
  checked?: boolean;
  required?: boolean;
  disabled?: boolean;
  label?: string;
  description?: string;
  class?: string;
  automationId?: string;
}

const {
  name,
  id,
  value,
  checked,
  required,
  disabled,
  label,
  description,
  class: extra = "",
  automationId,
} = Astro.props;

const fieldId = id ?? `${name}-${value}`;
---

<label
  for={fieldId}
  class:list={[
    "flex items-start gap-3 cursor-pointer select-none",
    disabled && "cursor-not-allowed opacity-60",
    extra,
  ]}
>
  <input
    type="radio"
    id={fieldId}
    name={name}
    value={value}
    checked={checked}
    required={required}
    disabled={disabled}
    data-automation-id={automationId}
    class="sr-only"
  />
  <span
    class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full border border-[color:var(--border)] bg-base-100 transition"
    aria-hidden="true"
  >
    <span class="h-2.5 w-2.5 scale-0 rounded-full bg-primary transition radio-dot"></span>
  </span>
  {(label || description) && (
    <span class="grid gap-0.5">
      {label && <span class="text-[0.93rem] font-medium text-base-content">{label}</span>}
      {description && <span class="text-[0.82rem] text-[color:var(--ganhuo-text-muted)]">{description}</span>}
    </span>
  )}
</label>

<style>
  input[type="radio"]:checked + span { border-color: var(--color-primary); }
  input[type="radio"]:checked + span .radio-dot { transform: scale(1); }
  input[type="radio"]:focus-visible + span {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 24%, transparent);
  }
</style>
