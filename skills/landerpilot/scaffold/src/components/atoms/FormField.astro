---
import Label from "./Label.astro";

interface Props {
  name?: string;
  id?: string;
  label?: string;
  required?: boolean;
  error?: string;
  hint?: string;
  class?: string;
}

const { name, id, label, required, error, hint, class: extra = "" } = Astro.props;
const fieldId = id ?? name;
---

<div class:list={["grid gap-2", extra]}>
  {label && (
    <Label htmlFor={fieldId} required={required}>{label}</Label>
  )}
  <slot />
  {hint && !error && (
    <p class="text-[0.82rem] text-[color:var(--ganhuo-text-muted)]" id={fieldId ? `${fieldId}-hint` : undefined}>
      {hint}
    </p>
  )}
  {error && (
    <p
      class="text-[0.82rem] text-[color:var(--color-error)]"
      id={fieldId ? `${fieldId}-error` : undefined}
      role="alert"
    >
      {error}
    </p>
  )}
</div>
