---
interface Props {
  href?: string;
  variant?: "primary" | "ghost" | "inverse" | "ink" | "line";
  size?: "md" | "sm";
  type?: "button" | "submit" | "reset";
  class?: string;
  automationId?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  class: extraClass = "",
  automationId,
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-[8px] border border-transparent font-sans font-[650] leading-none tracking-[-0.005em] transition-[transform,background-color,color,border-color,box-shadow] duration-200 hover:-translate-y-0.5";

const sizeClass =
  size === "sm" ? "min-h-[2.6rem] px-[1.1rem] text-[0.88rem]" : "min-h-[3.1rem] px-[1.55rem] text-[0.95rem]";

const variantClass = {
  primary:
    "bg-primary text-primary-content shadow-[0_10px_24px_-12px_color-mix(in_srgb,var(--color-primary)_70%,transparent)] hover:bg-[color-mix(in_srgb,var(--color-primary)_88%,#000)]",
  ghost:
    "border-[color:var(--border)] bg-base-100 text-base-content hover:border-[color:color-mix(in_srgb,var(--color-base-content)_38%,transparent)]",
  inverse:
    "bg-base-100 text-base-content hover:bg-[color:color-mix(in_srgb,var(--color-base-100)_86%,var(--color-primary))]",
  ink: "bg-neutral text-neutral-content hover:bg-[color:color-mix(in_srgb,var(--color-neutral)_84%,var(--color-primary))]",
  line: "border-[color:var(--border)] text-base-content hover:border-[color:color-mix(in_srgb,var(--color-base-content)_40%,transparent)]",
}[variant];
---

{
  href ? (
    <a
      href={href}
      class:list={[base, sizeClass, variantClass, extraClass]}
      data-automation-id={automationId}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class:list={[base, sizeClass, variantClass, extraClass]}
      data-automation-id={automationId}
    >
      <slot />
    </button>
  )
}
