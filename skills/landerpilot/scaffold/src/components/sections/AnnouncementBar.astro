---
import Container from "../atoms/Container.astro";

interface Props {
  text: string;
  link?: { text: string; href: string };
  variant?: "neutral" | "primary" | "accent";
  position?: "top" | "static";
}

const { text, link, variant = "neutral", position = "top" } = Astro.props;

const variantClass = {
  neutral: "bg-base-200 text-base-content border-[color:var(--border)]",
  primary: "bg-primary text-primary-content border-transparent",
  accent: "bg-accent text-accent-content border-transparent",
}[variant];

const posClass = position === "top" ? "" : "";
---

<aside
  class:list={[
    "w-full border-b text-center text-[0.85rem]",
    variantClass,
    posClass,
  ]}
  role="region"
  aria-label="Announcement"
  data-automation-id="section-announcement-bar"
>
  <Container class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 py-2.5">
    <span class="font-medium">{text}</span>
    {link && (
      <a
        href={link.href}
        class:list={[
          "inline-flex items-center gap-1 font-semibold underline-offset-4 hover:underline",
          variant === "neutral" ? "text-primary" : "",
        ]}
        data-automation-id="announcement-link"
      >
        {link.text}
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M3 6h6m0 0L6 3m3 3L6 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    )}
  </Container>
</aside>
