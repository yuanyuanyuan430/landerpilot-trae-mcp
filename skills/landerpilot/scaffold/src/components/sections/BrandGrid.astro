---
import Container from "../atoms/Container.astro";
import SectionHeader from "../atoms/SectionHeader.astro";
import Tag from "../atoms/Tag.astro";

interface BrandEntry {
  brand: string;
  slug?: string;
  category?: string;
  logo?: string;
  shortDescription?: string;
  score?: number;
  dealText?: string;
  price?: string;
  reviewHref?: string;
  affiliateUrl?: string;
  visitLabel?: string;
  pros?: string[];
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  brands: BrandEntry[];
  layout?: "grid" | "list";
  columns?: 2 | 3 | 4;
  showScore?: boolean;
  showPros?: boolean;
  reviewLabel?: string;
  visitLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  brands,
  layout = "grid",
  columns = 3,
  showScore = true,
  showPros = false,
  reviewLabel = "Read review",
  visitLabel = "Visit site",
} = Astro.props;

const colClass = {
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-2 lg:grid-cols-3",
  4: "sm:grid-cols-2 lg:grid-cols-4",
}[columns];

function scoreColor(score: number | undefined) {
  if (!score) return "var(--color-base-300)";
  if (score >= 9) return "var(--color-success)";
  if (score >= 7.5) return "var(--color-primary)";
  if (score >= 6) return "var(--color-warning)";
  return "var(--color-error)";
}
---

<section class="py-20 md:py-24" id="brands" data-automation-id="section-brand-grid">
  <Container>
    {title && (
      <SectionHeader
        eyebrow={eyebrow}
        title={title}
        description={description}
        class="mb-12"
      />
    )}

    {layout === "list" ? (
      <div class="grid gap-4">
        {brands.map((brand) => (
          <article
            class="lp-inview grid gap-5 rounded-[var(--ganhuo-radius)] border border-[color:var(--border)] bg-base-100 p-6 sm:grid-cols-[auto_1fr_auto] sm:items-center"
            data-automation-id={`brand-row-${brand.slug ?? brand.brand.toLowerCase()}`}
          >
            {brand.logo ? (
              <img src={brand.logo} alt={brand.brand} class="h-12 w-12 rounded-lg object-cover" />
            ) : showScore && typeof brand.score === "number" ? (
              <div
                class="lp-score-pill grid h-12 w-12 place-items-center rounded-full font-display text-base font-bold text-base-content"
                style={`--score-pct:${Math.round(brand.score * 10)};--score-color:${scoreColor(brand.score)}`}
              >
                <span>{brand.score.toFixed(1)}</span>
              </div>
            ) : null}
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-display text-[1.15rem] font-[560] tracking-[-0.015em] text-base-content">{brand.brand}</h3>
                {brand.category && <Tag size="sm">{brand.category}</Tag>}
              </div>
              {brand.shortDescription && (
                <p class="mt-1.5 text-[0.92rem] leading-[1.55] text-[color:var(--ganhuo-text-muted)]">{brand.shortDescription}</p>
              )}
            </div>
            <div class="flex shrink-0 flex-wrap items-center gap-2">
              {brand.reviewHref && (
                <a href={brand.reviewHref} class="text-[0.85rem] font-semibold text-primary hover:underline underline-offset-4">{reviewLabel}</a>
              )}
              {brand.affiliateUrl && (
                <a
                  href={brand.affiliateUrl}
                  rel="sponsored noopener"
                  class="inline-flex items-center justify-center rounded-[var(--radius-field,8px)] bg-primary px-4 py-2 text-[0.85rem] font-semibold text-primary-content transition hover:-translate-y-0.5"
                >
                  {brand.visitLabel || visitLabel}
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class:list={["grid gap-x-6 gap-y-8", colClass]}>
        {brands.map((brand) => (
          <article
            class="lp-inview group flex h-full flex-col rounded-[var(--ganhuo-radius)] border border-[color:var(--border)] bg-base-100 p-6 transition hover:-translate-y-1 hover:border-[color:color-mix(in_srgb,var(--color-primary)_32%,var(--border))] hover:shadow-[0_18px_38px_-22px_rgba(20,18,15,0.3)]"
            data-automation-id={`brand-card-${brand.slug ?? brand.brand.toLowerCase()}`}
          >
            <header class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3 min-w-0">
                {brand.logo ? (
                  <img src={brand.logo} alt={brand.brand} class="h-11 w-11 shrink-0 rounded-lg object-cover" />
                ) : (
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-base-200 font-display text-sm font-bold text-base-content/70">
                    {brand.brand.slice(0, 2).toUpperCase()}
                  </span>
                )}
                <div class="min-w-0">
                  <h3 class="truncate font-display text-[1.08rem] font-[560] tracking-[-0.015em] text-base-content">{brand.brand}</h3>
                  {brand.category && (
                    <span class="text-[0.78rem] font-medium text-[color:var(--ganhuo-text-muted)]">{brand.category}</span>
                  )}
                </div>
              </div>
              {showScore && typeof brand.score === "number" && (
                <div
                  class="lp-score-pill relative grid h-12 w-12 shrink-0 place-items-center rounded-full font-display text-[0.95rem] font-bold text-base-content"
                  style={`--score-pct:${Math.round(brand.score * 10)};--score-color:${scoreColor(brand.score)}`}
                >
                  <span>{brand.score.toFixed(1)}</span>
                </div>
              )}
            </header>
            {brand.shortDescription && (
              <p class="mt-4 text-[0.92rem] leading-[1.55] text-[color:var(--ganhuo-text-muted)]">
                {brand.shortDescription}
              </p>
            )}
            {showPros && brand.pros && brand.pros.length > 0 && (
              <ul class="mt-4 grid gap-1.5">
                {brand.pros.slice(0, 3).map((p) => (
                  <li class="flex gap-2 text-[0.85rem] leading-[1.5] text-base-content">
                    <span class="font-bold text-[color:var(--color-success)]" aria-hidden="true">✓</span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            )}
            {brand.dealText && (
              <div class="mt-5 rounded-[var(--radius-field,8px)] border border-dashed border-[color:color-mix(in_srgb,var(--color-primary)_40%,var(--border))] bg-[color:color-mix(in_srgb,var(--color-primary)_6%,transparent)] px-3 py-2 text-center text-[0.85rem] font-semibold text-primary">
                {brand.dealText}
              </div>
            )}
            <div class="mt-auto flex flex-wrap items-center gap-2 pt-5">
              {brand.affiliateUrl && (
                <a
                  href={brand.affiliateUrl}
                  rel="sponsored noopener"
                  class="inline-flex flex-1 items-center justify-center gap-1 rounded-[var(--radius-field,8px)] bg-primary px-4 py-2.5 text-[0.88rem] font-semibold text-primary-content transition hover:-translate-y-0.5"
                >
                  {brand.visitLabel || visitLabel}
                  <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                    <path d="M3 6.5h7m0 0L6.5 3m3.5 3.5L6.5 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              )}
              {brand.reviewHref && (
                <a
                  href={brand.reviewHref}
                  class="inline-flex items-center justify-center rounded-[var(--radius-field,8px)] border border-[color:var(--border)] px-4 py-2.5 text-[0.85rem] font-semibold text-base-content transition hover:border-primary hover:text-primary"
                >
                  {reviewLabel}
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    )}
  </Container>
</section>

<style>
  .lp-score-pill {
    background: conic-gradient(var(--score-color) calc(var(--score-pct) * 1%), var(--color-base-300) 0);
  }
  .lp-score-pill::before {
    content: "";
    position: absolute;
    inset: 4px;
    border-radius: 9999px;
    background: var(--color-base-100);
  }
  .lp-score-pill > span {
    position: relative;
    z-index: 1;
  }
</style>
