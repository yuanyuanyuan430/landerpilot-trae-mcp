---
import Container from "../atoms/Container.astro";

interface Props {
  eyebrow?: string;
  store: string;
  title?: string;
  description?: string;
  cashbackRate?: string;
  cashbackLabel?: string;
  rateNote?: string;
  logo?: string;
  category?: string;
  couponCount?: number;
  couponLabel?: string;
  updatedDate?: string;
  primaryCta?: { text: string; href: string; rel?: string };
  secondaryCta?: { text: string; href: string };
}

const {
  eyebrow,
  store,
  title,
  description,
  cashbackRate,
  cashbackLabel = "Cashback rate",
  rateNote,
  logo,
  category,
  couponCount,
  couponLabel = "active coupons",
  updatedDate,
  primaryCta,
  secondaryCta,
} = Astro.props;
---

<section class="border-b border-[color:var(--border)] bg-base-200 pb-10 pt-12 md:pb-14 md:pt-16" data-automation-id="section-store-hero">
  <Container>
    <div class="grid gap-8 lg:grid-cols-[1.3fr_1fr] lg:items-center">
      <div>
        {eyebrow && (
          <span class="inline-block text-[0.76rem] font-bold uppercase tracking-[0.16em] text-primary">{eyebrow}</span>
        )}
        <div class="mt-5 flex flex-wrap items-center gap-4">
          {logo && (
            <img src={logo} alt={store} class="h-14 w-14 rounded-xl border border-[color:var(--border)] bg-base-100 object-cover shadow-sm" />
          )}
          <div>
            <h1 class="font-display text-[clamp(2rem,4.4vw,3rem)] font-[560] leading-[1.08] tracking-[-0.024em] text-base-content">
              {title || store}
            </h1>
            {category && (
              <span class="mt-1.5 inline-block rounded-full bg-base-100 px-2.5 py-0.5 text-[0.78rem] font-medium text-[color:var(--ganhuo-text-muted)] border border-[color:var(--border)]">
                {category}
              </span>
            )}
          </div>
        </div>
        {description && (
          <p class="mt-5 max-w-2xl text-[clamp(1rem,1.25vw,1.13rem)] leading-[1.65] text-[color:var(--ganhuo-text-muted)]">
            {description}
          </p>
        )}
        <div class="mt-6 flex flex-wrap items-center gap-4 text-[0.85rem]">
          {typeof couponCount === "number" && couponCount > 0 && (
            <span class="inline-flex items-center gap-1.5 font-medium text-base-content">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 5h10v6H3z M3 8h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              </svg>
              <strong class="font-bold">{couponCount}</strong> {couponLabel}
            </span>
          )}
          {updatedDate && (
            <span class="text-[color:var(--ganhuo-text-muted)]">Updated {updatedDate}</span>
          )}
        </div>
        {(primaryCta || secondaryCta) && (
          <div class="mt-7 flex flex-wrap gap-3">
            {primaryCta && (
              <a
                href={primaryCta.href}
                rel={primaryCta.rel || "sponsored noopener"}
                class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-field,8px)] bg-primary px-6 py-3 text-[0.92rem] font-semibold text-primary-content transition hover:-translate-y-0.5 hover:shadow-md"
                data-automation-id="store-hero-primary-cta"
              >
                {primaryCta.text}
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 7h8m0 0L7.5 3.5M11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )}
            {secondaryCta && (
              <a href={secondaryCta.href} class="inline-flex items-center justify-center rounded-[var(--radius-field,8px)] border border-[color:var(--border)] px-5 py-3 text-[0.88rem] font-semibold text-base-content transition hover:border-primary hover:text-primary">
                {secondaryCta.text}
              </a>
            )}
          </div>
        )}
      </div>

      {cashbackRate && (
        <div class="lp-rate-card relative overflow-hidden rounded-[var(--ganhuo-radius)] bg-primary p-7 text-primary-content shadow-[0_20px_40px_-20px_color-mix(in_srgb,var(--color-primary)_45%,transparent)]">
          <span class="text-[0.78rem] font-bold uppercase tracking-[0.16em] opacity-80">{cashbackLabel}</span>
          <div class="mt-3 font-display text-[clamp(3rem,7vw,5rem)] font-[560] leading-none tracking-[-0.03em]">
            {cashbackRate}
          </div>
          {rateNote && (
            <p class="mt-3 text-[0.92rem] leading-[1.5] opacity-90">{rateNote}</p>
          )}
          {primaryCta && (
            <a
              href={primaryCta.href}
              rel={primaryCta.rel || "sponsored noopener"}
              class="mt-6 inline-flex items-center gap-1 rounded-[var(--radius-field,8px)] bg-primary-content px-4 py-2.5 text-[0.85rem] font-semibold text-primary transition hover:scale-[1.02]"
            >
              {primaryCta.text} →
            </a>
          )}
          <div class="lp-rate-card-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
        </div>
      )}
    </div>
  </Container>
</section>

<style>
  .lp-rate-card-bg {
    background: radial-gradient(40rem 24rem at 100% 0%, color-mix(in srgb, #fff 18%, transparent), transparent 60%);
  }
</style>
