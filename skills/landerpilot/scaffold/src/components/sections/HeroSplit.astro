---
import Container from "../atoms/Container.astro";
import Button from "../atoms/Button.astro";
import Eyebrow from "../atoms/Eyebrow.astro";

interface Props {
  brand?: string;
  title: string;
  subtitle?: string;
  primaryCta: { text: string; href: string };
  secondaryCta?: { text: string; href: string };
  image?: { src: string; alt?: string };
}

const { brand, title, subtitle, primaryCta, secondaryCta, image } = Astro.props;
---

<section
  class="lp-hero relative overflow-hidden pb-20 pt-[8.5rem] md:pb-28 md:pt-[10rem]"
  id="home"
  data-automation-id="section-hero-split"
>
  <Container class="relative grid items-center gap-14 xl:grid-cols-[1.05fr_0.95fr] xl:gap-12">
    <div class="min-w-0 max-w-2xl">
      {brand && (
        <span class="lp-reveal" style="--lp-d:.05s">
          <Eyebrow>{brand}</Eyebrow>
        </span>
      )}
      <h1
        class="lp-reveal mt-6 font-display text-[clamp(2.35rem,6.4vw,4.4rem)] font-[560] leading-[1.05] tracking-[-0.03em] text-base-content"
        style="--lp-d:.12s"
      >
        {title}
      </h1>
      {subtitle && (
        <p
          class="lp-reveal mt-6 max-w-xl text-[clamp(1.05rem,1.35vw,1.24rem)] leading-[1.68] text-[color:var(--ganhuo-text-muted)]"
          style="--lp-d:.2s"
        >
          {subtitle}
        </p>
      )}
      <div class="lp-reveal mt-9 flex flex-wrap gap-3" style="--lp-d:.28s">
        <Button
          variant="primary"
          href={primaryCta.href}
          automationId="hero-cta-primary"
        >
          {primaryCta.text}
        </Button>
        {secondaryCta && (
          <Button
            variant="ghost"
            href={secondaryCta.href}
            automationId="hero-cta-secondary"
          >
            {secondaryCta.text}
          </Button>
        )}
      </div>
    </div>
    {image && (
      <div class="lp-visual lp-reveal min-w-0" style="--lp-d:.34s">
        <figure class="lp-window">
          <div class="lp-window-bar"><span></span><span></span><span></span></div>
          <img src={image.src} alt={image.alt ?? title} />
        </figure>
      </div>
    )}
  </Container>
</section>

<style>
  .lp-hero {
    background-color: var(--color-base-100);
    background-image:
      radial-gradient(
        58rem 30rem at 82% -10%,
        color-mix(in srgb, var(--color-primary) 13%, transparent),
        transparent 72%
      ),
      radial-gradient(
        circle,
        color-mix(in srgb, var(--color-base-content) 6%, transparent) 1px,
        transparent 1.5px
      );
    background-size:
      auto,
      26px 26px;
  }
  .lp-hero::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }
  .lp-visual {
    position: relative;
  }
  .lp-visual::before {
    content: "";
    position: absolute;
    inset: 1.7rem -1.5rem -1.7rem 1.6rem;
    border-radius: 20px;
    background: color-mix(in srgb, var(--color-primary) 15%, transparent);
    z-index: 0;
  }
  .lp-window {
    position: relative;
    z-index: 1;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--color-base-100);
    overflow: hidden;
    box-shadow:
      0 1px 1px rgba(20, 18, 15, 0.05),
      0 14px 28px -14px rgba(20, 18, 15, 0.2),
      0 40px 70px -32px rgba(20, 18, 15, 0.26);
  }
  .lp-window-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.72rem 0.95rem;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--color-base-200) 65%, var(--color-base-100));
  }
  .lp-window-bar span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-base-content) 15%, transparent);
  }
  .lp-window img {
    display: block;
    width: 100%;
  }
  .lp-reveal {
    animation: lp-rise 0.85s cubic-bezier(0.2, 0.65, 0.25, 1) both;
    animation-delay: var(--lp-d, 0s);
  }
  @media print {
    .lp-reveal {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
