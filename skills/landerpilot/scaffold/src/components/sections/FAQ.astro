---
import Container from "../atoms/Container.astro";
import SectionHeader from "../atoms/SectionHeader.astro";

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: FAQItem[];
  interactive?: boolean;
}

const { eyebrow, title, description, items, interactive = true } = Astro.props;
---

<section
  class="py-20 md:py-24"
  id="faq"
  data-automation-id="section-faq"
>
  <Container size="tight">
    <SectionHeader
      eyebrow={eyebrow}
      title={title}
      description={description}
      class="mb-10"
    />
    <div class="divide-y divide-[color:var(--border)] border-y border-[color:var(--border)]">
      {items.map((item, idx) => (
        interactive ? (
          <details
            class="group py-6"
            data-automation-id={`faq-item-${idx}`}
          >
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-[1.1rem] font-[560] text-base-content"
            >
              <span>{item.question}</span>
              <span
                class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-[color:var(--border)] text-primary transition group-open:rotate-45"
                aria-hidden="true"
              >
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <p
              class="mt-4 max-w-2xl text-[0.98rem] leading-[1.65] text-[color:var(--ganhuo-text-muted)]"
            >
              {item.answer}
            </p>
          </details>
        ) : (
          <div class="py-6" data-automation-id={`faq-item-${idx}`}>
            <h3 class="font-display text-[1.1rem] font-[560] text-base-content">
              {item.question}
            </h3>
            <p class="mt-3 max-w-2xl text-[0.98rem] leading-[1.65] text-[color:var(--ganhuo-text-muted)]">
              {item.answer}
            </p>
          </div>
        )
      ))}
    </div>
  </Container>
</section>

<style>
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
