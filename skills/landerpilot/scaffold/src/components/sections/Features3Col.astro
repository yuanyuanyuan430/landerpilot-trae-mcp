---
import Container from "../atoms/Container.astro";
import SectionHeader from "../atoms/SectionHeader.astro";

interface FeatureItem {
  title: string;
  description: string;
  icon?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  items: FeatureItem[];
  variant?: "default" | "minimal";
}

const { eyebrow, title, description, items, variant = "default" } = Astro.props;
---

<section
  class="border-y border-[color:var(--border)] py-20 md:py-24"
  id="features"
  data-automation-id="section-features-3col"
>
  <Container>
    {title && (
      <SectionHeader
        eyebrow={eyebrow}
        title={title}
        description={description}
        class="mb-12"
      />
    )}
    <div class="grid gap-10 md:grid-cols-3 md:gap-8">
      {items.map((item, idx) => (
        <div
          class:list={[
            variant === "minimal"
              ? "lp-min-feature border-t-2 border-[color:var(--color-base-content)] pt-[1.5rem]"
              : "lp-inview rounded-[var(--ganhuo-radius)] border border-[color:var(--border)] bg-base-100 p-7 transition hover:-translate-y-1 hover:border-[color:color-mix(in_srgb,var(--color-primary)_32%,var(--border))] hover:shadow-[0_18px_38px_-22px_rgba(20,18,15,0.3)]",
          ]}
        >
          {variant === "minimal" && (
            <span class="font-display text-[0.95rem] font-semibold text-primary">
              {String(idx + 1).padStart(2, "0")}
            </span>
          )}
          {variant !== "minimal" && item.icon && (
            <div
              class="mb-5 inline-grid h-11 w-11 place-items-center rounded-[10px] text-primary"
              style="background: color-mix(in srgb, var(--color-primary) 12%, transparent);"
            >
              <span class="font-display text-lg font-bold">{item.icon}</span>
            </div>
          )}
          <h3
            class:list={[
              "font-display font-[560] leading-[1.25] tracking-[-0.015em] text-base-content",
              variant === "minimal" ? "mt-4 text-[1.3rem]" : "text-[1.2rem]",
            ]}
          >
            {item.title}
          </h3>
          <p
            class="mt-3 text-[0.95rem] leading-[1.65] text-[color:var(--ganhuo-text-muted)]"
          >
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </Container>
</section>
