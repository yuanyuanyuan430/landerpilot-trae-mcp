---
import Container from "../atoms/Container.astro";

interface Props {
  eyebrow?: string;
  rate: string;
  rateLabel?: string;
  description?: string;
  note?: string;
  primaryCta?: { text: string; href: string; rel?: string };
  secondaryCta?: { text: string; href: string };
  variant?: "band" | "card" | "split";
  containerSize?: "default" | "tight" | "wide";
}

const {
  eyebrow,
  rate,
  rateLabel = "Cashback rate",
  description,
  note,
  primaryCta,
  secondaryCta,
  variant = "band",
  containerSize = "default",
} = Astro.props;
---

<section
  class:list={[
    variant === "band" && "lp-rate-band relative overflow-hidden py-16 md:py-20 text-primary-content",
    variant === "card" && "py-12",
    variant === "split" && "py-16 md:py-20",
  ]}
  data-automation-id="section-cashback-rate-card"
>
  <Container size={containerSize}>
    {variant === "band" ? (
      <div class="relative grid items-center gap-6 text-center md:grid-cols-[1fr_auto] md:gap-12 md:text-left">
        <div>
          {eyebrow && (
            <span class="inline-block text-[0.78rem] font-bold uppercase tracking-[0.16em] opacity-80">{eyebrow}</span>
          )}
          <div class="mt-3 font-display text-[clamp(2.8rem,7vw,4.8rem)] font-[560] leading-[0.95] tracking-[-0.028em]">
            {rate}
          </div>
          {description && (
            <p class="mt-4 text-[clamp(1rem,1.3vw,1.18rem)] leading-[1.6] opacity-90 md:max-w-2xl">{description}</p>
          )}
          {note && <p class="mt-3 text-[0.85rem] opacity-75 md:max-w-2xl">{note}</p>}
        </div>
        {(primaryCta || secondaryCta) && (
          <div class="flex flex-wrap justify-center gap-3 md:justify-end">
            {primaryCta && (
              <a
                href={primaryCta.href}
                rel={primaryCta.rel || "sponsored noopener"}
                class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-field,8px)] bg-primary-content px-6 py-3 text-[0.92rem] font-semibold text-primary transition hover:scale-[1.02]"
              >
                {primaryCta.text} →
              </a>
            )}
            {secondaryCta && (
              <a href={secondaryCta.href} class="inline-flex items-center justify-center rounded-[var(--radius-field,8px)] border border-primary-content/40 px-5 py-3 text-[0.88rem] font-semibold text-primary-content transition hover:bg-primary-content/10">
                {secondaryCta.text}
              </a>
            )}
          </div>
        )}
        <div class="lp-rate-band-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
      </div>
    ) : variant === "card" ? (
      <div class="mx-auto max-w-md rounded-[var(--ganhuo-radius)] border border-[color:var(--border)] bg-base-100 p-7 text-center shadow-sm">
        {eyebrow && (
          <span class="inline-block text-[0.76rem] font-bold uppercase tracking-[0.14em] text-primary">{eyebrow}</span>
        )}
        <div class="mt-3 font-display text-[clamp(2.4rem,5vw,3.2rem)] font-[560] leading-none tracking-[-0.025em] text-primary">
          {rate}
        </div>
        <div class="mt-2 text-[0.85rem] font-medium text-[color:var(--ganhuo-text-muted)]">{rateLabel}</div>
        {description && (
          <p class="mt-4 text-[0.95rem] leading-[1.6] text-[color:var(--ganhuo-text-muted)]">{description}</p>
        )}
        {primaryCta && (
          <a
            href={primaryCta.href}
            rel={primaryCta.rel || "sponsored noopener"}
            class="mt-6 inline-flex w-full items-center justify-center gap-1 rounded-[var(--radius-field,8px)] bg-primary px-5 py-3 text-[0.88rem] font-semibold text-primary-content transition hover:-translate-y-0.5"
          >
            {primaryCta.text} →
          </a>
        )}
      </div>
    ) : (
      <div class="grid gap-8 rounded-[var(--ganhuo-radius)] border border-[color:var(--border)] bg-base-100 p-8 lg:grid-cols-[1fr_1fr] lg:items-center lg:p-10">
        <div>
          {eyebrow && (
            <span class="inline-block text-[0.78rem] font-bold uppercase tracking-[0.16em] text-primary">{eyebrow}</span>
          )}
          <div class="mt-4 font-display text-[clamp(3rem,7vw,5rem)] font-[560] leading-[0.95] tracking-[-0.028em] text-primary">
            {rate}
          </div>
          <div class="mt-2 text-[0.92rem] font-semibold uppercase tracking-[0.1em] text-[color:var(--ganhuo-text-muted)]">{rateLabel}</div>
        </div>
        <div>
          {description && (
            <p class="text-[clamp(1rem,1.25vw,1.13rem)] leading-[1.6] text-base-content">{description}</p>
          )}
          {note && <p class="mt-3 text-[0.85rem] text-[color:var(--ganhuo-text-muted)]">{note}</p>}
          {(primaryCta || secondaryCta) && (
            <div class="mt-6 flex flex-wrap gap-3">
              {primaryCta && (
                <a
                  href={primaryCta.href}
                  rel={primaryCta.rel || "sponsored noopener"}
                  class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-field,8px)] bg-primary px-5 py-3 text-[0.9rem] font-semibold text-primary-content transition hover:-translate-y-0.5"
                >
                  {primaryCta.text} →
                </a>
              )}
              {secondaryCta && (
                <a href={secondaryCta.href} class="inline-flex items-center justify-center rounded-[var(--radius-field,8px)] border border-[color:var(--border)] px-5 py-3 text-[0.88rem] font-semibold text-base-content transition hover:border-primary hover:text-primary">
                  {secondaryCta.text}
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    )}
  </Container>
</section>

<style>
  .lp-rate-band {
    background: var(--color-primary);
  }
  .lp-rate-band-bg {
    background: radial-gradient(50rem 24rem at 100% 0%, color-mix(in srgb, #fff 14%, transparent), transparent 60%);
  }
</style>
