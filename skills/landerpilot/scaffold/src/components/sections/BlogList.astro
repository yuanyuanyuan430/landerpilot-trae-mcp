---
import Container from "../atoms/Container.astro";
import SectionHeader from "../atoms/SectionHeader.astro";
import Tag from "../atoms/Tag.astro";
import Avatar from "../atoms/Avatar.astro";

interface BlogPost {
  title: string;
  excerpt?: string;
  href: string;
  cover?: { src: string; alt?: string };
  category?: string;
  tags?: string[];
  date?: string;
  readingTime?: string;
  author?: { name: string; avatar?: string };
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  posts: BlogPost[];
  layout?: "grid" | "featured" | "list";
  columns?: 2 | 3;
}

const { eyebrow, title, description, posts, layout = "grid", columns = 3 } = Astro.props;

const colClass = columns === 2 ? "md:grid-cols-2" : "md:grid-cols-2 lg:grid-cols-3";
const [featured, ...rest] = posts;
---

<section class="py-20 md:py-24" id="blog" data-automation-id="section-blog-list">
  <Container>
    {title && (
      <SectionHeader
        eyebrow={eyebrow}
        title={title}
        description={description}
        class="mb-14"
      />
    )}

    {layout === "featured" && featured ? (
      <div class="grid gap-12">
        <article class="lp-inview grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center">
          {featured.cover && (
            <a href={featured.href} class="block overflow-hidden rounded-[var(--ganhuo-radius)] border border-[color:var(--border)] bg-base-200">
              <img
                src={featured.cover.src}
                alt={featured.cover.alt ?? featured.title}
                loading="lazy"
                class="aspect-[16/10] w-full object-cover transition duration-500 hover:scale-[1.02]"
              />
            </a>
          )}
          <div>
            {featured.category && <Tag size="sm">{featured.category}</Tag>}
            <h3 class="mt-4 font-display text-[clamp(1.6rem,2.4vw,2.2rem)] font-[560] leading-[1.18] tracking-[-0.022em] text-base-content">
              <a href={featured.href} class="transition hover:text-primary">{featured.title}</a>
            </h3>
            {featured.excerpt && (
              <p class="mt-4 text-[clamp(1rem,1.2vw,1.13rem)] leading-[1.65] text-[color:var(--ganhuo-text-muted)]">
                {featured.excerpt}
              </p>
            )}
            <div class="mt-6 flex items-center gap-4 text-[0.85rem] text-[color:var(--ganhuo-text-muted)]">
              {featured.author && (
                <span class="flex items-center gap-2">
                  <Avatar src={featured.author.avatar} name={featured.author.name} size="sm" />
                  <span class="font-medium text-base-content">{featured.author.name}</span>
                </span>
              )}
              {featured.date && <span>{featured.date}</span>}
              {featured.readingTime && <span>· {featured.readingTime}</span>}
            </div>
          </div>
        </article>
        {rest.length > 0 && <hr class="h-px border-0 bg-[color:var(--border)]" />}
        <div class:list={["grid gap-x-8 gap-y-12", colClass]}>
          {rest.map((post) => (
            <article class="lp-inview group flex flex-col">
              {post.cover && (
                <a href={post.href} class="block overflow-hidden rounded-[var(--ganhuo-radius)] border border-[color:var(--border)] bg-base-200">
                  <img
                    src={post.cover.src}
                    alt={post.cover.alt ?? post.title}
                    loading="lazy"
                    class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                  />
                </a>
              )}
              <div class="mt-5 flex-1">
                {post.category && <Tag size="sm">{post.category}</Tag>}
                <h3 class="mt-3 font-display text-[1.2rem] font-[560] leading-[1.32] tracking-[-0.015em]">
                  <a href={post.href} class="text-base-content transition hover:text-primary">{post.title}</a>
                </h3>
                {post.excerpt && (
                  <p class="mt-3 text-[0.95rem] leading-[1.6] text-[color:var(--ganhuo-text-muted)]">{post.excerpt}</p>
                )}
              </div>
              {(post.date || post.readingTime || post.author) && (
                <div class="mt-5 flex items-center gap-3 text-[0.82rem] text-[color:var(--ganhuo-text-muted)]">
                  {post.author && (
                    <span class="flex items-center gap-2">
                      <Avatar src={post.author.avatar} name={post.author.name} size="xs" />
                      <span class="text-base-content">{post.author.name}</span>
                    </span>
                  )}
                  {post.date && <span>{post.date}</span>}
                  {post.readingTime && <span>· {post.readingTime}</span>}
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    ) : layout === "list" ? (
      <div class="divide-y divide-[color:var(--border)]">
        {posts.map((post) => (
          <article class="grid grid-cols-1 gap-2 py-6 md:grid-cols-[1fr_auto] md:items-center md:gap-8">
            <div>
              {post.category && <Tag size="sm">{post.category}</Tag>}
              <h3 class="mt-2 font-display text-[1.25rem] font-[560] leading-[1.3] tracking-[-0.018em]">
                <a href={post.href} class="text-base-content transition hover:text-primary">{post.title}</a>
              </h3>
              {post.excerpt && (
                <p class="mt-2 text-[0.95rem] leading-[1.6] text-[color:var(--ganhuo-text-muted)]">{post.excerpt}</p>
              )}
            </div>
            {(post.date || post.readingTime) && (
              <div class="flex shrink-0 items-center gap-3 text-[0.82rem] text-[color:var(--ganhuo-text-muted)]">
                {post.date && <span>{post.date}</span>}
                {post.readingTime && <span>· {post.readingTime}</span>}
              </div>
            )}
          </article>
        ))}
      </div>
    ) : (
      <div class:list={["grid gap-x-8 gap-y-12", colClass]}>
        {posts.map((post) => (
          <article class="lp-inview group flex flex-col">
            {post.cover && (
              <a href={post.href} class="block overflow-hidden rounded-[var(--ganhuo-radius)] border border-[color:var(--border)] bg-base-200">
                <img
                  src={post.cover.src}
                  alt={post.cover.alt ?? post.title}
                  loading="lazy"
                  class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                />
              </a>
            )}
            <div class="mt-5 flex-1">
              {post.category && <Tag size="sm">{post.category}</Tag>}
              <h3 class="mt-3 font-display text-[1.2rem] font-[560] leading-[1.32] tracking-[-0.015em]">
                <a href={post.href} class="text-base-content transition hover:text-primary">{post.title}</a>
              </h3>
              {post.excerpt && (
                <p class="mt-3 text-[0.95rem] leading-[1.6] text-[color:var(--ganhuo-text-muted)]">{post.excerpt}</p>
              )}
            </div>
            {(post.date || post.readingTime || post.author) && (
              <div class="mt-5 flex items-center gap-3 text-[0.82rem] text-[color:var(--ganhuo-text-muted)]">
                {post.author && (
                  <span class="flex items-center gap-2">
                    <Avatar src={post.author.avatar} name={post.author.name} size="xs" />
                    <span class="text-base-content">{post.author.name}</span>
                  </span>
                )}
                {post.date && <span>{post.date}</span>}
                {post.readingTime && <span>· {post.readingTime}</span>}
              </div>
            )}
          </article>
        ))}
      </div>
    )}
  </Container>
</section>
