---
import Container from "../atoms/Container.astro";
import Avatar from "../atoms/Avatar.astro";
import Tag from "../atoms/Tag.astro";
import { sanitizeBlogHtml } from "../../lib/sanitize-blog-html.mjs";

interface Props {
  title: string;
  excerpt?: string;
  category?: string;
  tags?: string[];
  date?: string;
  readingTime?: string;
  author?: { name: string; role?: string; avatar?: string };
  cover?: { src: string; alt?: string; caption?: string };
  contentHtml?: string;
}

const { title, excerpt, category, tags, date, readingTime, author, cover, contentHtml } = Astro.props;
const safeContentHtml = sanitizeBlogHtml(contentHtml);
---

<article class="py-16 md:py-24" data-automation-id="section-blog-post">
  <Container size="tight">
    <header class="mb-12">
      <div class="flex flex-wrap items-center gap-3 text-[0.85rem] text-[color:var(--ganhuo-text-muted)]">
        {category && <Tag size="sm">{category}</Tag>}
        {date && <span>{date}</span>}
        {readingTime && <span>· {readingTime}</span>}
      </div>
      <h1 class="mt-5 font-display text-[clamp(2.2rem,5vw,3.6rem)] font-[560] leading-[1.08] tracking-[-0.028em] text-base-content">
        {title}
      </h1>
      {excerpt && (
        <p class="mt-5 text-[clamp(1.1rem,1.5vw,1.35rem)] leading-[1.65] text-[color:var(--ganhuo-text-muted)]">
          {excerpt}
        </p>
      )}
      {author && (
        <div class="mt-7 flex items-center gap-3">
          <Avatar src={author.avatar} name={author.name} size="md" />
          <div>
            <div class="text-[0.95rem] font-semibold text-base-content">{author.name}</div>
            {author.role && (
              <div class="text-[0.82rem] text-[color:var(--ganhuo-text-muted)]">{author.role}</div>
            )}
          </div>
        </div>
      )}
    </header>

    {cover && (
      <figure class="mb-12 -mx-2 md:-mx-4">
        <div class="overflow-hidden rounded-[var(--ganhuo-radius)] border border-[color:var(--border)] bg-base-200">
          <img src={cover.src} alt={cover.alt ?? title} loading="eager" class="w-full" />
        </div>
        {cover.caption && (
          <figcaption class="mt-3 text-center text-[0.82rem] text-[color:var(--ganhuo-text-muted)]">
            {cover.caption}
          </figcaption>
        )}
      </figure>
    )}

    {safeContentHtml ? (
      <div class="lp-prose" set:html={safeContentHtml} />
    ) : (
      <div class="lp-prose">
        <slot />
      </div>
    )}

    {tags && tags.length > 0 && (
      <footer class="mt-16 flex flex-wrap items-center gap-2 border-t border-[color:var(--border)] pt-8">
        <span class="text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-[color:var(--ganhuo-text-muted)]">Tagged</span>
        {tags.map((tag) => <Tag size="sm">{tag}</Tag>)}
      </footer>
    )}
  </Container>
</article>

<style>
  .lp-prose {
    font-size: clamp(1.05rem, 1.2vw, 1.13rem);
    line-height: 1.75;
    color: var(--color-base-content);
  }
  .lp-prose > * + * { margin-top: 1.2em; }
  .lp-prose h2 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.18;
    margin-top: 2.4em;
    color: var(--color-base-content);
  }
  .lp-prose h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 560;
    letter-spacing: -0.015em;
    margin-top: 1.8em;
    color: var(--color-base-content);
  }
  .lp-prose a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
  .lp-prose strong { font-weight: 650; }
  .lp-prose blockquote {
    border-left: 3px solid var(--color-primary);
    padding-left: 1.2rem;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-base-content);
  }
  .lp-prose code {
    background: var(--color-base-200);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }
  .lp-prose pre {
    background: var(--color-neutral);
    color: var(--color-neutral-content);
    padding: 1.2rem 1.4rem;
    border-radius: var(--ganhuo-radius);
    overflow-x: auto;
    font-size: 0.88rem;
  }
  .lp-prose pre code { background: transparent; padding: 0; }
  .lp-prose ul, .lp-prose ol { padding-left: 1.4em; }
  .lp-prose li { margin-top: 0.4em; }
  .lp-prose img { border-radius: var(--ganhuo-radius); }
  .lp-prose hr { border: 0; height: 1px; background: var(--border); margin: 2.4em 0; }
</style>
