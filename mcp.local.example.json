{
  "mcpServers": {
    "landerpilot": {
      "command": "/absolute/path/to/node",
      "args": ["/absolute/path/to/landerpilot-mcp/cloud-proxy.mjs"],
      "env": {
        "LANDERPILOT_API_KEY": "粘贴你的 LanderPilot API Key",
        "LANDERPILOT_MCP_URL": "https://landerpilot.com/api/mcp"
      }
    },
    "landerpilot_local_tools": {
      "command": "/absolute/path/to/node",
      "args": ["/absolute/path/to/landerpilot-mcp/server.mjs"]
    }
  }
}
